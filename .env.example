# ELKARION - Variables de entorno
# Copia este archivo a .env y rellena los valores reales

# Supabase (backend / base de datos / auth)
VITE_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="tu-anon-key-publica"
VITE_SUPABASE_PROJECT_ID="tu-project-id"

# Solo servidor (no exponer al cliente)
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="tu-anon-key-publica"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-SECRETA"

# Lovable AI Gateway (mentor ELKAR + PestScan + Diagnose)
# Si exportas fuera de Lovable, sustituye por tu propia OpenAI/Gemini key
LOVABLE_API_KEY="tu-lovable-api-key"